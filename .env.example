# --- LLM (any OpenAI-compatible server: Ollama, llama.cpp server, or a hosted free tier) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120
# "none" turns off qwen3's thinking mode, which otherwise makes every answer much slower.
# Leave blank for models without a thinking mode.
LLM_REASONING_EFFORT=none

# --- Embeddings: "api" for real use (OpenAI-compatible /v1/embeddings), "hash" only for offline tests ---
# Uses the LLM server above unless EMBEDDING_BASE_URL / EMBEDDING_API_KEY are set.
# One-time: ollama pull nomic-embed-text. Re-run python ingest.py after changing the model.
EMBEDDING_BACKEND=api
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Retrieval ---
# Chunks passed to the LLM, and the most characters kept from each. Prompt size drives speed on a CPU.
TOP_K=3
LLM_CHUNK_CHARS=700
# A chunk with no shared keyword is used only if its vector similarity reaches this.
# 0.70 is calibrated for nomic-embed-text; recalibrate both scores after changing EMBEDDING_MODEL.
STRONG_VECTOR_SCORE=0.70
# A keyword match must also reach this similarity, so one everyday word ("time") isn't enough.
MIN_VECTOR_SCORE=0.55

# --- The bot's name, used when it introduces itself and in the chat UI ---
BOT_NAME=Course Guide

# --- API ---
ALLOWED_ORIGINS=https://smartworking.training,http://localhost:8000
RATE_LIMIT_PER_MINUTE=20
MAX_QUESTION_CHARS=500
